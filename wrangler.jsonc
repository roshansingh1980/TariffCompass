{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tariffcompass",
  "main": "worker.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["alerts@tariffcompass.ca"]
    }
  ],
  "triggers": {
    "crons": ["0 13 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
